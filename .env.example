DATABASE_PATH=/data/land-collector.db
ADMIN_ADDR=:8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

DATA_GO_KR_SERVICE_KEY=
LAND_API_URL=https://provider.example/api?serviceKey={serviceKey}&pnu={pnu}&format=json
CHARACTERISTIC_API_URL=https://provider.example/api?serviceKey={serviceKey}&pnu={pnu}&format=json
PRICE_API_URL=https://provider.example/api?serviceKey={serviceKey}&pnu={pnu}&format=json
USE_PLAN_API_URL=https://provider.example/api?serviceKey={serviceKey}&pnu={pnu}&format=json

WORKERS=16
REQUESTS_PER_SECOND=10
LAND_RPS=10
CHARACTERISTIC_RPS=10
PRICE_RPS=10
USE_PLAN_RPS=10
HTTP_TIMEOUT_SECONDS=20
MAX_RETRIES=4
BATCH_SIZE=200
PNU_FILE=/data/pnu.txt
